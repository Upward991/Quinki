{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quinki",
  "version": "0.1.0",
  "identifier": "com.quinki.shell",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "windows": [
      {
        "title": "Quinki",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}