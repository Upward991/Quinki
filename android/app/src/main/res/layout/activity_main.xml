<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040406">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/configPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/config_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#e8e8ec"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="3dp"
                android:text="Connect to Quinki on your Mac. Open Quinki there, go to Settings, Web app, and scan the QR code. Or type the link and the access token shown in the same panel."
                android:textColor="#888892"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/linkInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:autofillHints=""
                android:background="@drawable/bg_field"
                android:hint="Link (https://…)"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#e8e8ec"
                android:textColorHint="#5a5a64"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/tokenInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:background="@drawable/bg_field"
                android:hint="Access token"
                android:inputType="textVisiblePassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#e8e8ec"
                android:textColorHint="#5a5a64"
                android:textSize="14sp" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_outline"
                android:stateListAnimator="@null"
                android:text="Scan QR code"
                android:textAllCaps="false"
                android:textColor="#7aa2f7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_filled"
                android:stateListAnimator="@null"
                android:text="Connect"
                android:textAllCaps="false"
                android:textColor="#040406"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text=""
                android:textColor="#e0566a"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
